{
  "mcpServers": {
    "computer-use": {
      "command": "/bin/sh",
      "args": [
        "-c",
        "exec node \"${PI_CODING_AGENT_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/pi}/mcp/chatgpt-computer-use/server.mjs\""
      ],
      "timeout": 130,
      "exposure": "codemode",
      "description": "Control macOS apps through official ChatGPT Computer Use"
    },
    "fly-mcp": {
      "enabled": false,
      "url": "https://mcp.fly.io",
      "exposure": "codemode",
      "description": "Manage Fly.io apps, Machines, volumes, secrets, Managed Postgres, and Sprites"
    },
    "pinky": {
      "command": "/opt/homebrew/bin/pinkyctl",
      "args": [
        "mcp"
      ],
      "exposure": "codemode",
      "description": "Operate phones through Pinky with human approvals"
    },
    "radius": {
      "url": "https://radius.pi.dev/mcp",
      "auth": {
        "provider": "radius"
      }
    }
  }
}
