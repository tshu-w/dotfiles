{
  "defaultProvider": "openai",
  "defaultModel": "gpt-6-astra",
  "defaultThinkingLevel": "medium",
  "followUpMode": "one-at-a-time",
  "steeringMode": "all",
  "defaultTools": [
    "+program"
  ],
  "extensions": [
    "extensions/official/handoff.ts",
    "extensions/official/interactive-shell.ts",
    "extensions/official/questionnaire.ts",
    "extensions/pi-custom/index.ts",
    "extensions/pi-custom/title-status.ts",
    "extensions/pi-web/index.ts"
  ],
  "packages": [
    {
      "source": "git:github.com/anthropics/skills",
      "extensions": [],
      "skills": [
        "skills/pdf/**"
      ],
      "prompts": [],
      "themes": []
    },
    {
      "source": "git:github.com/tshu-w/pi-control"
    },
    {
      "source": "git:github.com/tshu-w/pi-agents"
    },
    {
      "source": "git:github.com/addyosmani/agent-skills",
      "skills": []
    },
    "npm:@marckrenn/pi-sub-status",
    {
      "source": "git:github.com/tshu-w/pi-tape"
    },
    {
      "source": "git:github.com/mattpocock/skills",
      "skills": []
    },
    "git:github.com/tshu-w/pi-codex-remote",
    {
      "source": "git:github.com/tshu-w/pi-env"
    }
  ],
  "lastChangelogVersion": "1.1.0",
  "theme": "light/dark",
  "treeFilterMode": "all",
  "doubleEscapeAction": "tree",
  "retry": {
    "maxRetries": 5
  },
  "terminal": {
    "showTerminalProgress": true
  },
  "showCacheMissNotices": true,
  "quietStartup": "header",
  "pi-agents": {
    "extensions": [
      "extensions/pi-web/index.ts",
      "git/github.com/tshu-w/pi-env/src/index.ts",
      "extensions/secret-guard/index.ts",
      "extensions/pi-custom/index.ts"
    ]
  },
  "enabledModels": [
    "claude-code/claude-opus-5-5",
    "openai/gpt-6-astra",
    "openai/gpt-6.1-sol"
  ],
  "pi-custom": {
    "fast": false,
    "codexCompaction": true,
    "transcriptOptimization": true
  },
  "defaultProjectTrust": "always",
  "tuiMode": "regular",
  "showHardwareCursor": true,
  "deviceId": "ba8ef7d4-9749-4eee-bac0-1e91f977f8e1"
}